# --- Backend (backend/README.md tiene el detalle). Todas opcionales: sin credenciales, los canales
# --- escriben en consola y los avisos quedan como «simulado».
# Servidor
PORT=8080
# DATABASE_PATH=                       # por defecto backend/data/baliza.db (SQLite)
# BALIZA_KEY_FILE=                     # por defecto backend/data/server-keys.json
BALIZA_SIGN_SEED_HEX=                  # 32 B en hex: semilla Ed25519 del servidor. FÍJALA en producción: el teléfono fija las llaves del servidor al registrarse
BALIZA_SEAL_SK_HEX=                    # 32 B en hex: llave privada X25519 del servidor
PUBLIC_BASE_URL=                       # base de los enlaces /r/<token>; en Render se toma de RENDER_EXTERNAL_URL
TRUST_PROXY=false                      # true detrás de Render/nginx
CORS_ORIGIN=*
# Seguridad
ADMIN_TOKEN=                           # habilita /v1/admin/*, /v1/dev/simulate-reply y /v1/webhooks/sms
DASHBOARD_TOKEN=                       # si se define, /v1/incidents y /v1/stream exigen Bearer o ?token=
ALLOW_UNVERIFIED_CONTACTS=false        # true: los canales reales también contactan a contactos sin verificar
# Fases 4 y 5 (apagadas por defecto)
FEATURE_PAYMENTS=false
FEATURE_RIDES=false
CMD_MAX_PER_DAY=10
CMD_MAX_AMOUNT_PER_DAY=500
# Agente: redacta los avisos con Claude (sin clave se usa una plantilla)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=6000
# WhatsApp por Kapso (el canal «sms» del contrato sale por aquí si está configurado)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=                  # secreto del webhook /v1/webhooks/whatsapp (firma X-Webhook-Signature)
KAPSO_TEMPLATE_ALERT=                  # plantilla aprobada para el primer aviso
KAPSO_TEMPLATE_MESSAGE=                # plantilla aprobada para mensajes del usuario
KAPSO_TEMPLATE_LANG=es
# KAPSO_TEMPLATE_LANG_EN=
# SMS_PROVIDER=twilio                  # fuerza Twilio aunque Kapso esté configurado
# Otros canales
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Límites (valores por defecto)
RATE_EGRESS_PER_MIN=120
RATE_SENDER_PER_MIN=30
RATE_REGISTER_PER_MIN=20
RATE_REPLY_PER_HOUR=20
